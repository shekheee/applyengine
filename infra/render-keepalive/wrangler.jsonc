{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applyengine-render-keepalive",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
