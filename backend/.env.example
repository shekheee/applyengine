# Which LLM provider to use: "openai", "anthropic", or "mock"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_COACH_MODELS=gpt-5.6-sol,gpt-5.5
OPENAI_EMBED_MODEL=text-embedding-3-small
SPEECH_TRANSCRIPTION_MODELS=gpt-4o-transcribe,whisper-1
SPEECH_TTS_MODEL=tts-1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_ENABLED=true

# Anthropic is optional. Add it to COACH_PROVIDER_CHAIN only when access is active.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest

# App
DATABASE_URL=sqlite:///./applyengine.db
CORS_ORIGINS=http://localhost:3000,https://applyengine.ajayshekhawat.uk,https://www.applyengine.ajayshekhawat.uk,https://applyengine.vercel.app

# Anthropic (coach fallback)
ANTHROPIC_COACH_MODEL=claude-opus-5
ANTHROPIC_COACH_MODELS=claude-opus-5,claude-fable-5,claude-opus-4-8

# Gemini (coach fallback) — also reads GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_API_KEY=
GEMINI_COACH_MODEL=gemini-3.1-pro-preview
GEMINI_COACH_MODELS=gemini-3.1-pro-preview
GEMINI_AUDIO_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_ANALYSIS_ENABLED=true

# Coach provider fallback order (comma-separated). GPT is primary; Gemini is backup.
COACH_PROVIDER_CHAIN=openai,gemini
MEMORY_MODEL=gpt-5.6-sol
# Long random secret used to sign JWTs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
